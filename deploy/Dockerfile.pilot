FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY . .
RUN addgroup -S atmos && adduser -S -G atmos atmos && mkdir -p /var/lib/atmos-pilot && chown -R atmos:atmos /app /var/lib/atmos-pilot
USER atmos
EXPOSE 4180
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:4180/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "pilot-server.mjs"]
