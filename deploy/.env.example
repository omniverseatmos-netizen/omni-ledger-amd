POSTGRES_DB=atmos_pilot
POSTGRES_USER=atmos_app
# Use a secret file for POSTGRES_PASSWORD; never put it in Git.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
DATABASE_URL=postgres://atmos_app:REPLACE_ME@postgres:5432/atmos_pilot
PILOT_BOOTSTRAP_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ATMOS_PASSWORD_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ATMOS_TOKEN_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Phase 3: production OIDC / Microsoft Entra ID. This disables local password login.
AUTH_MODE=oidc
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_APPLICATION_CLIENT_SECRET
OIDC_REDIRECT_URI=https://pilot.example.com/v1/auth/oidc/callback
OIDC_STATE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
OIDC_TENANT_CLAIM=tid
OIDC_ROLE_CLAIM=roles
OIDC_ALLOWED_TENANTS=<tenant-id>

# A short-lived token for the isolated k6 load-test environment.
PILOT_TOKEN=REPLACE_WITH_LOAD_TEST_TOKEN
BASE_URL=http://pilot-api:4180
RECALL_BATCHES=batch-a,batch-b,batch-c
